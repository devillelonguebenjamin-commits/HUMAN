{
  "version": 8,
  "name": "SIJAMAIS hors ligne",
  "glyphs": "__GLYPHES__/{fontstack}/{range}.pbf",
  "sources": {
    "fond": {
      "type": "vector",
      "url": "pmtiles://__PMTILES__",
      "attribution": "© les contributeurs d'OpenStreetMap · Protomaps"
    }
  },
  "layers": [
    { "id": "fond", "type": "background", "paint": { "background-color": "#C9DCE6" } },
    { "id": "terre", "type": "fill", "source": "fond", "source-layer": "earth", "paint": { "fill-color": "#F3F4EF" } },
    { "id": "vegetation", "type": "fill", "source": "fond", "source-layer": "landcover",
      "filter": ["in", ["get", "kind"], ["literal", ["forest", "scrub", "grassland"]]],
      "paint": { "fill-color": "#DCE7D3", "fill-opacity": 0.8 } },
    { "id": "parcs", "type": "fill", "source": "fond", "source-layer": "landuse",
      "filter": ["in", ["get", "kind"], ["literal", ["park", "forest", "nature_reserve", "national_park", "wood", "golf_course"]]],
      "paint": { "fill-color": "#D3E3C8" } },
    { "id": "hopitaux-zone", "type": "fill", "source": "fond", "source-layer": "landuse",
      "filter": ["==", ["get", "kind"], "hospital"], "paint": { "fill-color": "#F6D9DD" } },
    { "id": "eau", "type": "fill", "source": "fond", "source-layer": "water",
      "filter": ["==", ["geometry-type"], "Polygon"], "paint": { "fill-color": "#A9C9DC" } },
    { "id": "cours-eau", "type": "line", "source": "fond", "source-layer": "water",
      "filter": ["==", ["geometry-type"], "LineString"],
      "paint": { "line-color": "#A9C9DC", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 15, 2.5] } },
    { "id": "batiments", "type": "fill", "source": "fond", "source-layer": "buildings", "minzoom": 13,
      "paint": { "fill-color": "#E2E4DC", "fill-outline-color": "#D3D6CC" } },
    { "id": "chemins", "type": "line", "source": "fond", "source-layer": "roads", "minzoom": 13,
      "filter": ["==", ["get", "kind"], "path"],
      "paint": { "line-color": "#B7A58A", "line-width": 1, "line-dasharray": [2, 1.5] } },
    { "id": "voies-ferrees", "type": "line", "source": "fond", "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "rail"], "paint": { "line-color": "#A7ABA3", "line-width": 1.2 } },
    { "id": "petites-routes", "type": "line", "source": "fond", "source-layer": "roads", "minzoom": 11,
      "filter": ["in", ["get", "kind"], ["literal", ["minor_road", "other"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#FFFFFF", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.6, 16, 6] } },
    { "id": "routes", "type": "line", "source": "fond", "source-layer": "roads",
      "filter": ["in", ["get", "kind"], ["literal", ["major_road", "medium_road"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#F7E3A8", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 16, 9] } },
    { "id": "autoroutes", "type": "line", "source": "fond", "source-layer": "roads",
      "filter": ["==", ["get", "kind"], "highway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#F2B58A", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 16, 11] } },
    { "id": "limites", "type": "line", "source": "fond", "source-layer": "boundaries",
      "paint": { "line-color": "#9AA59C", "line-width": 1, "line-dasharray": [3, 2] } },
    { "id": "services-secours", "type": "circle", "source": "fond", "source-layer": "pois", "minzoom": 12,
      "filter": ["in", ["get", "kind"], ["literal", ["hospital", "clinic", "pharmacy", "fire_station", "police", "townhall"]]],
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 12, 4, 17, 8],
        "circle-stroke-color": "#FFFFFF", "circle-stroke-width": 1.5,
        "circle-color": ["match", ["get", "kind"],
          "hospital", "#C8102E", "clinic", "#C8102E", "pharmacy", "#00843D",
          "fire_station", "#C2410C", "police", "#005EB8", "townhall", "#1F3B2D", "#4A5A51"]
      } },
    { "id": "services-noms", "type": "symbol", "source": "fond", "source-layer": "pois", "minzoom": 14,
      "filter": ["in", ["get", "kind"], ["literal", ["hospital", "clinic", "pharmacy", "fire_station", "police", "townhall"]]],
      "layout": { "text-field": ["coalesce", ["get", "name:fr"], ["get", "name"]], "text-font": ["Noto Sans Medium"],
        "text-size": 11, "text-offset": [0, 1.1], "text-anchor": "top", "text-max-width": 8 },
      "paint": { "text-color": "#17241C", "text-halo-color": "#FFFFFF", "text-halo-width": 1.5 } },
    { "id": "noms-routes", "type": "symbol", "source": "fond", "source-layer": "roads", "minzoom": 14,
      "filter": ["in", ["get", "kind"], ["literal", ["major_road", "medium_road", "minor_road"]]],
      "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name:fr"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"], "text-size": 11 },
      "paint": { "text-color": "#4E5E54", "text-halo-color": "#FFFFFF", "text-halo-width": 1.5 } },
    { "id": "noms-quartiers", "type": "symbol", "source": "fond", "source-layer": "places", "minzoom": 12,
      "filter": ["in", ["get", "kind"], ["literal", ["neighbourhood", "macrohood"]]],
      "layout": { "text-field": ["coalesce", ["get", "name:fr"], ["get", "name"]], "text-font": ["Noto Sans Italic"], "text-size": 11 },
      "paint": { "text-color": "#5B6B60", "text-halo-color": "#F3F4EF", "text-halo-width": 1.5 } },
    { "id": "noms-communes", "type": "symbol", "source": "fond", "source-layer": "places",
      "filter": ["==", ["get", "kind"], "locality"],
      "layout": { "text-field": ["coalesce", ["get", "name:fr"], ["get", "name"]], "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 16], "text-max-width": 9 },
      "paint": { "text-color": "#17241C", "text-halo-color": "#F3F4EF", "text-halo-width": 2 } }
  ]
}
